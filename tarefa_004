Do while

1)
#include<stdio.h>

char d[10];
int i;
float dis;

int main()
{
    do{
        printf("Movimente seu robô!");
        printf("\n\nPara onde ele deve se mover?\n(Direita, esquerda, frente ou trás?)");
        scanf("%s", &d[10]);
    
        printf("\n\nPor qual distancia (em cm)?\n");
        scanf("%f", &dis);
        
        printf("\n\nO robô se moveu para %s ", d);
        printf("\nEle percorreu uma distancia de %f cm", dis);
        
        printf("\n\nPara mover novamente, pressione 1. Se não, precione 0");
        scanf("%d", &i);
        
    }while(i==1);    
    
    return 0;
}

