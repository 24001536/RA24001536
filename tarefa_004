#include <stdio.h>
int main(){
    
    int continuar;
    float litros, volume;
    /*volume total = 50 litros*/
    
    do{
        printf("\n\nInsira o volume em litros de combustível: ");
        scanf("%f", &litros);
        volume = ((litros / 50.0) * 100.0);
        
        if(volume < 15){
            printf("\n\nVolume de combustível insuficiente! Abasteça seu carro!");
        }
        else{
            printf("\n\nVolume aceitável.");
        }
        
        printf("\n\nPorcentagem referente ao volume: %f", volume);
        
        printf("\n\nContinuar? (1-sim, 0-não)");
        scanf("%d", &continuar);
        
    }while(continuar == 1);
    
    return 0;
}

