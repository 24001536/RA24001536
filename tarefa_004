#include <stdio.h>

int main()
{
    int passos, total = 0, i;
    
    do{
        printf("Digite o numero de passos atingido:");
        scanf("%d", &passos);
        
        total += passos;
        
        ("Deseja adicionar o proximo numero atingido?(sim-1, nao-0):");
        scanf("%d", &i);
    }while(i == 1);
    
    printf("Voce atingiu um total de %d passos!", total);
    
    if(total == 10000){
        printf("Sua meta foi atingida!");
    }
    else{
        printf("Sua meta nao foi atingida, mas continue tentando!");
    }

    return 0;
}

