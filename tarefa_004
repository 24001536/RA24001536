#include <stdio.h>
#include <time.h>

int main(){
    
    float leitura;
    int i;
    
    do{
        printf("\n\nDigite a leitura feita pelo sensor:");
        scanf("%f", &leitura);
        
        if(leitura < 10){
            printf("\n\nA distancia %f é menor que 10 cm.\nO programa foi encerrado.", leitura);
            break;
        }
        else{
            printf("\nDistancia lida pelo sensor:\n%f", leitura);
        }
        
        printf("\n\nLer distancia novamente?(sim-1, não-0)");
        scanf("%d", &i);
    }while(i==1);
    
    return 0;
}

