While e Do while

1)
#include <stdio.h>
int main(){
    int continuar;
    do{
        float temp;
        printf("Insira a temperatura em graus Célsius: ");
        scanf("%f", &temp);
        
        if((temp < 20) || (temp > 25)){
            printf("Alerta! Temperatura inaceitável.");
        }
        else{
            printf("Temperatura aceitável.");
        }
        
        printf("/n/nDeseja medir a proxima temperatura? (1-Sim, 0-Nao): ");
        scanf("%d", &continuar);
        
    }while(continuar == 1);
    
    return 0;
}

