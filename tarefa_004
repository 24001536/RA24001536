#include<stdio.h>

int i, j, comandos[3] = {1,2,3};


int main()
{
    do{
        printf("Movimente seu robô!");
        printf("\n\nDiga o que ele deve fazer:");
        printf("\n\nLigar lampada = 1\nAcionar som = 2\nMover o braço = 3\n\n");
        scanf("%d", &i);
        
        switch(comandos[i]){
            
            case 1:
                printf("\nA lampada foi acionada!");
            case 2:
                printf("\nO som foi acionado!");
            case 3:
                printf("\nO braço mexeu!");
        }
        
        printf("\n\nPara mover novamente, pressione 1. Se não, precione 0: ");
        scanf("%d", &j);
        
    }while(j==1);    
    
    return 0;
}

